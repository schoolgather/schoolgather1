{
  "name": "Review",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "school_admin_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Denormalised admissions contacts so schools can moderate their own reviews"
    },
    "student_email": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "1 to 5 stars"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "Parent",
        "Student",
        "Alumnus",
        "Prospective family"
      ],
      "default": "Parent"
    },
    "would_recommend": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "school_id",
    "student_email",
    "rating"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.school_admin_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.school_admin_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}