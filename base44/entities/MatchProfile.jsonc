{
  "name": "MatchProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "answers": {
      "type": "object",
      "properties": {}
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "school_id": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}